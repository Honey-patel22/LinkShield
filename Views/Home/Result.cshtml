@model ScanRecord
@{ ViewData["Title"] = "Scan results"; var findings = (Model.Findings ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries); var color = Model.RiskLevel == "High" ? "red" : Model.RiskLevel == "Medium" ? "amber" : "green"; }
<section class="page-hero compact"><span class="eyebrow">SCAN COMPLETE · REPORT #@Model.Id</span><h1>Here’s what we <em>found.</em></h1><p>Review the signals below before deciding what to do next.</p></section><section class="result-layout"><div class="panel score-panel"><div class="score-ring @color" style="--score:@Model.RiskScore"><div><strong>@Model.RiskScore</strong><small>/100</small></div></div><span class="risk-pill @color">@Model.RiskLevel risk signals</span><h2>@(Model.RiskLevel == "High" ? "Pause before proceeding" : Model.RiskLevel == "Medium" ? "Take a closer look" : "Few warning signs found")</h2><p class="muted">This score reflects only the rules included in this student demo. It is not a reputation database or malware scan.</p><a class="btn btn-primary" asp-controller="History" asp-action="Index">View scan history →</a></div><div class="panel findings-panel"><div class="panel-title"><div><span class="eyebrow">ANALYSIS DETAILS</span><h2>Signals to know</h2></div><span class="count-badge">@findings.Length findings</span></div><div class="scanned-url"><span>SCANNED ADDRESS</span><p>@Model.Url</p></div>@foreach (var f in findings) { <div class="finding"><span class="finding-mark">!</span><div><b>@f</b><p>Use this as a prompt to verify the destination, not as proof of malicious activity.</p></div></div> }<div class="safety-note"><b>Remember:</b> a low score does not mean a URL is guaranteed safe. Never enter passwords or payment details just because a scan looks clear.</div></div></section><div class="page-actions"><a asp-controller="Home" asp-action="Index" class="text-link">← Scan another URL</a><a asp-controller="Threats" asp-action="Index" class="text-link">Learn about threats ↗</a></div>
