@model IEnumerable<ThreatsController.Threat>
@{ ViewData["Title"] = "Threat library"; }
<section class="page-hero"><span class="eyebrow">THE KNOWLEDGE CORNER</span><h1>Know the trick.<br/><em>Spot the red flags.</em></h1><p>Short, practical explainers to help you recognize common online threats before they catch you off guard.</p></section><div class="filter-chips"><a class="chip @(ViewBag.Category == null ? "active" : "")" asp-action="Index">All topics</a><a class="chip @(ViewBag.Category == "Social engineering" ? "active" : "")" asp-action="Index" asp-route-category="Social engineering">Social engineering</a><a class="chip @(ViewBag.Category == "Domain tricks" ? "active" : "")" asp-action="Index" asp-route-category="Domain tricks">Domain tricks</a><a class="chip @(ViewBag.Category == "Connection security" ? "active" : "")" asp-action="Index" asp-route-category="Connection security">Connection security</a><a class="chip @(ViewBag.Category == "Malware" ? "active" : "")" asp-action="Index" asp-route-category="Malware">Malware</a></div><section class="threat-grid">@foreach(var t in Model) { <article class="threat-card"><div class="threat-card-top"><span class="threat-emoji">@t.Icon</span><span class="category-label">@t.Category</span></div><h2>@t.Title</h2><p>@t.Summary</p><div class="tip-box"><b>What you can do</b><p>@t.Tip</p></div></article> }</section><section class="bottom-cta"><div><span class="eyebrow">PUT KNOWLEDGE INTO PRACTICE</span><h2>Not sure about a link?</h2><p>Run a quick check, then verify the result independently.</p></div><a class="btn btn-dark" asp-controller="Home" asp-action="Index">Open scanner ↗</a></section>
