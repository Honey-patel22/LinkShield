<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] — LinkShield</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">⌁</span><span>link<span class="brand-accent">shield</span><small>SAFER CLICKS START HERE</small></span></a><button class="menu-toggle" onclick="document.body.classList.toggle('nav-open')">☰</button><nav class="nav"><a asp-controller="Home" asp-action="Index">Scanner</a><a asp-controller="Dashboard" asp-action="Index">Dashboard</a><a asp-controller="History" asp-action="Index">History</a><a asp-controller="Threats" asp-action="Index">Threat library</a><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Home" asp-action="FAQ">FAQ</a><a asp-controller="Pages" asp-action="Contact">Contact</a></nav><div class="nav-actions">@if (Context.Session.GetString("UserName") != null) { <span class="user-chip">◉ @Context.Session.GetString("UserName")</span><a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Logout">Log out</a> } else { <a class="login-link" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Register">Get started ↗</a> }</div></header>
<main>@if (TempData["Message"] != null) { <div class="toast">✓ @TempData["Message"]</div> } @RenderBody()</main>
<footer class="footer"><div class="footer-brand"><span class="brand-mark">⌁</span><b>linkshield</b></div><span>Digital awareness, one link at a time.</span><div class="footer-links"><a asp-controller="Home" asp-action="FAQ">FAQ</a><a asp-controller="Pages" asp-action="Contact">Contact</a><span>© 2026 LinkShield</span></div></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
