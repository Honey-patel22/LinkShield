@model IEnumerable<ScanRecord>
@{ ViewData["Title"] = "Dashboard"; }
<section class="page-hero"><span class="eyebrow">YOUR SAFETY OVERVIEW</span><h1>A clearer view of your <em>link habits.</em></h1><p>Welcome back, @(Context.Session.GetString("UserName") ?? "safety explorer"). Your recent checks at a glance.</p></section><section class="stats-grid"><div class="stat-card"><span class="stat-icon peach-bg">⌁</span><span class="stat-label">Total scans</span><strong>@ViewBag.Total</strong><small>All saved checks</small></div><div class="stat-card"><span class="stat-icon red-bg">!</span><span class="stat-label">High risk</span><strong>@ViewBag.High</strong><small>Review with extra care</small></div><div class="stat-card"><span class="stat-icon yellow-bg">◉</span><span class="stat-label">Medium risk</span><strong>@ViewBag.Medium</strong><small>Check the details</small></div><div class="stat-card"><span class="stat-icon green-bg">✓</span><span class="stat-label">Low risk</span><strong>@ViewBag.Low</strong><small>Few configured signals</small></div></section><section class="panel table-panel"><div class="panel-title"><div><span class="eyebrow">YOUR ACTIVITY</span><h2>Recent scans</h2></div><a class="text-link" asp-controller="History" asp-action="Index">View all →</a></div>@if (!Model.Any()) { <div class="empty-state"><div>⌕</div><h3>Your first scan starts here</h3><p>Check a URL and your scan will appear in this dashboard.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Scan a link →</a></div> } else { <div class="table-scroll"><table><thead><tr><th>Website</th><th>Risk level</th><th>Score</th><th>Date checked</th><th></th></tr></thead><tbody>@foreach(var s in Model) { <tr><td><b class="url-cell">@s.Url</b></td><td><span class="risk-pill @(s.RiskLevel.ToLower())">@s.RiskLevel</span></td><td><b>@s.RiskScore/100</b></td><td>@s.ScannedAt.ToString("dd MMM yyyy, HH:mm")</td><td><a asp-controller="History" asp-action="Details" asp-route-id="@s.Id" class="text-link">Details ↗</a></td></tr> }</tbody></table></div> }</section><section class="tip-banner"><span class="tip-symbol">✳</span><div><b>Safety tip of the day</b><p>When a message asks you to “verify now,” open the service through its official app instead of following the link.</p></div><a asp-controller="Threats" asp-action="Index">Explore tips ↗</a></section>
