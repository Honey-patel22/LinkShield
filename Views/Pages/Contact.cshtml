@model ContactMessage
@{ ViewData["Title"] = "Contact"; }
<section class="page-hero"><span class="eyebrow">LET'S TALK</span><h1>Questions, ideas, <em>or feedback?</em></h1><p>Send a note about the project or suggest a topic for the safety library.</p></section><section class="contact-layout"><div class="contact-aside"><div class="contact-art">✉</div><h2>We’re listening.</h2><p>This form demonstrates server-side validation and saving submitted messages to MySQL.</p><div class="contact-detail"><span>✳</span><div><b>Project showcase</b><small>ASP.NET Core MVC mini-project</small></div></div><div class="contact-detail"><span>⌁</span><div><b>Learn more</b><small>Explore the threat library and FAQ</small></div></div></div><form asp-action="Contact" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="field-error"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control" placeholder="Your name"/><span asp-validation-for="Name" class="field-error"></span><label asp-for="Email"></label><input asp-for="Email" class="form-control" placeholder="you@example.com"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Message"></label><textarea asp-for="Message" class="form-control" rows="5" placeholder="Tell us what’s on your mind…"></textarea><span asp-validation-for="Message" class="field-error"></span><button class="btn btn-primary full-btn" type="submit">Send message ↗</button></form></section>
