@model IEnumerable<ScanRecord>
@{ ViewData["Title"] = "Scan history"; }
<section class="page-hero"><span class="eyebrow">YOUR SCAN ARCHIVE</span><h1>Every check, <em>in one place.</em></h1><p>Search, inspect, edit or remove saved scan records.</p></section><section class="panel table-panel"><form method="get" class="filter-bar"><input name="q" value="@ViewBag.Query" placeholder="Search by URL…"/><select name="risk"><option value="">All risk levels</option><option selected="@(ViewBag.Risk == "Low")" value="Low">Low</option><option selected="@(ViewBag.Risk == "Medium")" value="Medium">Medium</option><option selected="@(ViewBag.Risk == "High")" value="High">High</option></select><button class="btn btn-dark" type="submit">Filter</button><a class="text-link" asp-action="Index">Clear</a></form>@if (!Model.Any()) { <div class="empty-state"><div>⌕</div><h3>No scans match</h3><p>Try a different search, or scan a new URL.</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Scan a link →</a></div> } else { <div class="table-scroll"><table><thead><tr><th>Website URL</th><th>Risk</th><th>Score</th><th>Scanned</th><th>Actions</th></tr></thead><tbody>@foreach(var s in Model) { <tr><td class="url-cell">@s.Url</td><td><span class="risk-pill @s.RiskLevel.ToLower()">@s.RiskLevel</span></td><td>@s.RiskScore/100</td><td>@s.ScannedAt.ToString("dd MMM yyyy, HH:mm")</td><td class="actions"><a asp-action="Details" asp-route-id="@s.Id">View</a><a asp-action="Edit" asp-route-id="@s.Id">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@s.Id">Delete</a></td></tr> }</tbody></table></div> }</section>
