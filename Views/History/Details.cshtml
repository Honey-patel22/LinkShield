@model ScanRecord
@{ ViewData["Title"] = "Scan details"; }
<section class="page-hero compact"><span class="eyebrow">SCAN RECORD #@Model.Id</span><h1>Scan <em>details.</em></h1></section><section class="panel detail-card"><dl class="detail-list"><dt>URL</dt><dd>@Model.Url</dd><dt>Risk level</dt><dd><span class="risk-pill @Model.RiskLevel.ToLower()">@Model.RiskLevel</span></dd><dt>Risk score</dt><dd>@Model.RiskScore / 100</dd><dt>Scanned at</dt><dd>@Model.ScannedAt.ToString("f")</dd><dt>Submitted by</dt><dd>@(Model.SubmittedBy ?? "Guest")</dd><dt>Findings</dt><dd><ul>@foreach(var f in Model.Findings.Split('|', StringSplitOptions.RemoveEmptyEntries)){<li>@f</li>}</ul></dd></dl><div class="page-actions"><a class="btn btn-dark" asp-action="Index">← Back to history</a><a class="btn btn-outline" asp-action="Edit" asp-route-id="@Model.Id">Edit record</a></div></section>
